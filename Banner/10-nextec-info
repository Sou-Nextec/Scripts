#!/usr/bin/env bash
# Nextec | Identificação e resumo do sistema (servidores da Nextec)
# Lê NEXTEC_NOME_SERVIDOR, NEXTEC_FUNCAO e NEXTEC_AMBIENTE de /etc/environment.
set -euo pipefail
export LC_ALL=C.UTF-8

ler() {
  grep -m1 "^$1=" /etc/environment 2>/dev/null | cut -d= -f2- \
    | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//' | tr -d '\000-\037\\' || true
}

NOME="$(ler NEXTEC_NOME_SERVIDOR)"
FUNCAO="$(ler NEXTEC_FUNCAO)"
AMBIENTE="$(ler NEXTEC_AMBIENTE)"
HOST="$(hostname -s)"

R=$'\033[0m'; B=$'\033[1m'; D=$'\033[38;5;245m'; P=$'\033[38;2;92;80;255m'
RED=$'\033[1;31m'; YEL=$'\033[1;33m'; GRN=$'\033[1;32m'

case "${AMBIENTE,,}" in
  produ*)   AMB_COR="$RED" ;;
  homolog*) AMB_COR="$YEL" ;;
  *)        AMB_COR="$GRN" ;;
esac

if [[ -n "$NOME" ]]; then
  SERVIDOR="${B}${NOME^^}${R} ${D}(${HOST})${R}"
else
  SERVIDOR="${B}${HOST^^}${R}"
fi

campo() { printf '  %s%s%s%s\n' "$D" "$1" "$R" "$2"; }

CPUS=$(nproc)
read -r L1 L5 L15 _ < /proc/loadavg
read -r DPCT DUSED DSIZE < <(df -h --output=pcent,used,size / | tail -1)
MEM=$(free -m | awk '/^Mem:/ {printf "%.0f%% de %.1f GB", $3/$2*100, $2/1024}')
SWP=$(free -m | awk '/^Swap:/ {if ($2>0) printf "%.0f%% de %.1f GB", $3/$2*100, $2/1024; else print "não configurado"}')
UP=$(cut -d. -f1 /proc/uptime)
UPTXT="$((UP/86400))d $((UP%86400/3600))h $((UP%3600/60))min"
IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}' || true)
PROCS=$(ps -e --no-headers | wc -l)
USERS=$(who | wc -l)

printf '\n'
campo "Servidor:   " "$SERVIDOR"
[[ -n "$FUNCAO" ]]   && campo "Função:     " "$FUNCAO"
[[ -n "$AMBIENTE" ]] && campo "Ambiente:   " "${AMB_COR}${AMBIENTE}${R}"
campo "Gestão:     " "${P}Nextec Soluções em TI${R}  ${D}|${R}  (62) 3602-1667 ${D}·${R} noc@nex.tec.br"
printf '\n'
campo "Carga:      " "${L1} / ${L5} / ${L15} ${D}(${CPUS} CPUs)${R}"
campo "Disco /:    " "${DPCT} usado (${DUSED} de ${DSIZE})"
campo "Memória:    " "$MEM"
campo "Swap:       " "$SWP"
campo "Uptime:     " "$UPTXT"
campo "Processos:  " "${PROCS}  ${D}|${R}  ${D}Usuários:${R} ${USERS}"
campo "IP:         " "${IP:-não identificado}"
printf '\n'
