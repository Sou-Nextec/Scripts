#!/usr/bin/env bash
# Nextec | Identificação e resumo do sistema (servidores da Nextec)
# Lê NEXTEC_NOME_SERVIDOR, NEXTEC_FUNCAO e NEXTEC_AMBIENTE de /etc/environment.
set -euo pipefail
# Usa um locale UTF-8 que exista no sistema (C.UTF-8 não existe em todas as distribuições)
NX_LOCALE="$(locale -a 2>/dev/null | grep -iE '^(c|en_us|pt_br)\.utf-?8$' | head -1 || true)"
[[ -n "$NX_LOCALE" ]] && export LC_ALL="$NX_LOCALE"
unset NX_LOCALE

ler() {
  grep -m1 "^$1=" /etc/environment 2>/dev/null | cut -d= -f2- \
    | sed -e 's/^["'"'"']//' -e 's/["'"'"']$//' | tr -d '\000-\037\\' || true
}

NOME="$(ler NEXTEC_NOME_SERVIDOR)"
FUNCAO="$(ler NEXTEC_FUNCAO)"
AMBIENTE="$(ler NEXTEC_AMBIENTE)"
HOST="$(hostname -s 2>/dev/null || uname -n)"
HOST="${HOST%%.*}"

R=$'\033[0m'; B=$'\033[1m'; D=$'\033[38;5;245m'; P=$'\033[38;2;92;80;255m'
RED=$'\033[1;31m'; YEL=$'\033[1;33m'; GRN=$'\033[1;32m'

case "${AMBIENTE,,}" in
  produ*)   AMB_COR="$RED" ;;
  homolog*) AMB_COR="$YEL" ;;
  *)        AMB_COR="$GRN" ;;
esac

if [[ -n "$NOME" ]]; then
  SERVIDOR="${B}${NOME^^}${R} ${D}(${HOST})${R}"
else
  SERVIDOR="${B}${HOST^^}${R}"
fi

campo() { printf '  %s%s%s%s\n' "$D" "$1" "$R" "$2"; }

CPUS=$(nproc 2>/dev/null || grep -c '^processor' /proc/cpuinfo)
read -r L1 L5 L15 _ < /proc/loadavg
read -r DPCT DUSED DSIZE < <(df -hP / | awk 'NR==2 {print $5, $3, $2}')
MEM=$(awk '/^MemTotal:/ {t=$2} /^MemAvailable:/ {a=$2} /^MemFree:/ {f=$2} /^Buffers:/ {b=$2} /^Cached:/ {c=$2}
  END {if (a == "") a = f + b + c; printf "%.0f%% de %.1f GB", (t-a)/t*100, t/1048576}' /proc/meminfo)
SWP=$(awk '/^SwapTotal:/ {t=$2} /^SwapFree:/ {f=$2}
  END {if (t > 0) printf "%.0f%% de %.1f GB", (t-f)/t*100, t/1048576; else print "não configurado"}' /proc/meminfo)
UP=$(cut -d. -f1 /proc/uptime)
UPTXT="$((UP/86400))d $((UP%86400/3600))h $((UP%3600/60))min"
IP=$(ip -4 route get 1.1.1.1 2>/dev/null | awk '{for (i=1; i<=NF; i++) if ($i=="src") {print $(i+1); exit}}' || true)
[[ -n "$IP" ]] || IP=$(hostname -I 2>/dev/null | awk '{print $1}' || true)
PROCS=$(find /proc -maxdepth 1 -name '[0-9]*' -type d 2>/dev/null | wc -l)
USERS=$(who 2>/dev/null | wc -l)

printf '\n'
campo "Servidor:   " "$SERVIDOR"
[[ -n "$FUNCAO" ]]   && campo "Função:     " "$FUNCAO"
[[ -n "$AMBIENTE" ]] && campo "Ambiente:   " "${AMB_COR}${AMBIENTE}${R}"
campo "Gestão:     " "${P}Nextec Soluções em TI${R}  ${D}|${R}  (62) 3602-1667 ${D}·${R} noc@nex.tec.br"
printf '\n'
campo "Carga:      " "${L1} / ${L5} / ${L15} ${D}(${CPUS} CPUs)${R}"
campo "Disco /:    " "${DPCT} usado (${DUSED} de ${DSIZE})"
campo "Memória:    " "$MEM"
campo "Swap:       " "$SWP"
campo "Uptime:     " "$UPTXT"
campo "Processos:  " "${PROCS}  ${D}|${R}  ${D}Usuários:${R} ${USERS}"
campo "IP:         " "${IP:-não identificado}"
printf '\n'
